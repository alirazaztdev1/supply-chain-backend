<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta http-equiv='X-UA-Compatible' content='IE=edge' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>Food & Beverage</title>
	</head>
	<body style='margin: 0; padding: 0; box-sizing: border-box'>
		<center
			style='
        width: 100%;
        table-layout: fixed;
        background-color: #ffffff;
        /* padding-top: 30px; */
        /* padding-bottom: 30px; */
      '
		>
			<table
				cellpadding='0'
				style="
          margin: 0 auto;
          width: 100%;
          max-width: 800px;
          border-spacing: 0;
          font-family: 'Roboto', sans-serif;
          border: 1px solid #dedddd;
        "
				width='100%'
			>
				<tr>
					<td>
						<table
							style='
                margin: 0 auto;
                width: 100%;
                /* max-width: 800px; */
                border-spacing: 0;
                background-color: #ffffff;
                /* border: 1px solid #dedddd; */
              '
							width='100%'
						>
							<!--Header Section-->
							<tr style='text-align: center'>
								<td
									background='{{imageURL}}'
									height='220px'
									style='
                    width: 100%;
                    background-size: cover;
                    background-position: center;
                    color: #ffffff;
                  '
								>
									<img
										src='data:image/png;base64,'
									/>
									<p
										style="
                      padding: 0;
                      margin: 0;
                      letter-spacing: 6px;
                      font-size: 20px;
                      font-family: 'Roboto', sans-serif;
                    "
									>
										Food and Beverage
										{{server}}
									</p>
								</td>
							</tr>
						</table>
						<table
							style='
                margin: auto;
                width: 100%;
                border-spacing: 0;
                background-color: #ffffff;
                text-align: center;
                margin-bottom: 200px;
                margin-top: 120px;
              '
							width='100%'
						>
							<tr>
								<td style='line-height: 1.3'>
									<p
										style="
                      font-size: 23px;
                      margin-bottom: 30px;
                      font-family: 'Roboto', sans-serif;
                      font-weight: 500;
                    "
									>
										{{message}}
									</p>
									<p
										style='
                      background-color: #074b87;
                      display: inline;
                      border-radius: 10px;
                      margin-top: 10px;
                      color: #ffffff;
                      padding: 13px 40px;
                    '
									>
										<a
											rel='nofollow'
											href={{button.url}}
											target='_blank'
											style='
                        text-decoration: none;
                        color: #ffffff;
                        background-color: #074b87;
                        border-radius: 10px;
                      '
										>{{button.text}}</a>
									</p>
								</td>
							</tr>
						</table>
						<table
							style='
                width: 100%;
                max-width: 720px;
                height: 105px;
                /* margin-left: 40px;
                margin-right: 40px; */
                margin: 0 auto;
                margin-bottom: 30px;
                margin-top: 20px;
                border-spacing: 0;
                text-align: center;
                border-top: 1px solid #dedddd;
              '
						>
							<tr>
								<td>
									<img
										src='data:image/png;base64,'
										alt='logo'
										style='margin-top: 31px; margin-bottom: 10px'
									/>
									<p
										style="
                      margin: 0;
                      font-size: 14px;
                      color: #222222;
                      font-family: 'Roboto', sans-serif;
                    "
									>
										© F<span style='font-size: 13px'>&amp;</span>B System.
										427/428 G4 Block, M.A. Johar Town Lahore
									</p>
								</td>
							</tr>
						</table>
					</td>
				</tr>
			</table>
		</center>
	</body>
</html>